# Copy to .env. Never commit actual credentials.
PORT=3000
# demo or binance. Demo balances are synthetic; prices come from Binance.
PORTFOLIO_MODE=demo
# Supported regional alternative: https://api.binance.us
BINANCE_BASE_URL=https://api.binance.com
# Official market-data-only endpoint; use https://api.binance.us for US markets.
BINANCE_MARKET_URL=https://data-api.binance.vision
# Enable reading only and disable trading/withdrawals on the key.
BINANCE_API_KEY=
BINANCE_API_SECRET=
